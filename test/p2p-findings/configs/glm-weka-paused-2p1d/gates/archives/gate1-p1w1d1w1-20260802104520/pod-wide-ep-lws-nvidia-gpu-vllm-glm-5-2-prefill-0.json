                    "find /dev/shm -type f -delete\n\n#################\n# RUN vLLM GLM-5.2-FP8 prefill worker\n#################\n\nGPU_MEM_UTIL=${PREFILL_GPU_MEM_UTIL:-$([ \"${LWS_GROUP_SIZE:-1}\" -gt 1 ] \u0026\u0026 echo 0.88 || echo 0.92)}\n\nMTP_ARGS=\"\"\nif [ \"${ENABLE_MTP:-1}\" = \"1\" ]; then\n  MTP_ARGS=\"--speculative-config {\\\"method\\\":\\\"mtp\\\",\\\"num_speculative_tokens\\\":${MTP_NUM_TOKENS:-3}}\"\nfi\n\nSTART_RANK=$(( ${LWS_WORKER_INDEX:-0} * DP_SIZE_LOCAL ))\nKV_EVENTS_BASE=$((5557 - START_RANK))\nKV_EVENTS_ARGS=\"--kv-events-config {\\\"enable_kv_cache_events\\\":true,\\\"publisher\\\":\\\"zmq\\\",\\\"endpoint\\\":\\\"tcp://*:${KV_EVENTS_BASE}\\\",\\\"topic\\\":\\\"kv@${POD_IP}:8000@zai-org/GLM-5.2-FP8\\\"}\"\n\ncase \"${OFFLOADING_MODE:-off}\" in\n  cpu)\n    KV_TRANSFER_CONFIG='{\"kv_connector\":\"MultiConnector\",\n                          \"kv_role\":\"kv_both\",\n                          \"kv_load_failure_policy\":\"fail\",\n                          \"kv_connector_extra_config\":{\n                            \"connectors\":[\n                              {\"kv_connector\":\"NixlConnector\",\"kv_role\":\"kv_both\"},\n                              {\"kv_connector\":\"OffloadingConnector\",\"kv_role\":\"kv_both\",\n                               \"kv_connector_extra_config\":{\n                                 \"cpu_bytes_to_use\":'\"${KV_OFFLOAD_CPU_BYTES:-107374182400}\"',\n                                 \"eviction_policy\":\"lru\"\n                            }}]}}'\n    ;;\n  tiered)\n    KV_TRANSFER_CONFIG='{\"kv_connector\":\"MultiConnector\",\n                          \"kv_role\":\"kv_both\",\n                          \"kv_load_failure_policy\":\"fail\",\n                          \"kv_connector_extra_config\":{\n                            \"connectors\":[\n                              {\"kv_connector\":\"NixlConnector\",\"kv_role\":\"kv_both\"},\n                              {\"kv_connector\":\"OffloadingConnector\",\"kv_role\":\"kv_both\",\n                               \"kv_connector_extra_config\":{\n                                 \"spec_name\":\"TieringOffloadingSpec\",\n                                 \"cpu_bytes_to_use\":'\"${KV_OFFLOAD_CPU_BYTES:-107374182400}\"',\n                                 \"eviction_policy\":\"lru\",\n                                 \"secondary_tiers\":[{\"type\":\"fs\",\"root_dir\":\"/mnt/nvme-cache\",\n                                   \"n_read_threads\":16,\"n_write_threads\":16}]\n                            }}]}}'\n    ;;\n  p2p-tiered)\n    P2P_BASE=$((7777 - START_RANK))\n    KV_TRANSFER_CONFIG='{\"kv_connector\":\"MultiConnector\",\n                          \"kv_role\":\"kv_both\",\n                          \"kv_load_failure_policy\":\"fail\",\n                          \"kv_connector_extra_config\":{\n                            \"connectors\":[\n                              {\"kv_connector\":\"NixlConnector\",\"kv_role\":\"kv_both\"},\n                              {\"kv_connector\":\"OffloadingConnector\",\"kv_role\":\"kv_both\",\n                               \"kv_connector_extra_config\":{\n                                 \"spec_name\":\"TieringOffloadingSpec\",\n                                 \"cpu_bytes_to_use\":'\"${KV_OFFLOAD_CPU_BYTES:-107374182400}\"',\n                                 \"eviction_policy\":\"lru\",\n                                 \"offload_prompt_only\":false,\n                                 \"secondary_tiers\":[{\"type\":\"p2p\",\"host\":\"'\"${POD_IP}\"'\",\"port\":'\"${P2P_BASE}\"'}]\n                            }}]}}'\n    ;;\n  *)\n    KV_TRANSFER_CONFIG='{\"kv_connector\":\"NixlConnector\",\n                          \"kv_role\":\"kv_both\",\n                          \"kv_load_failure_policy\":\"fail\"}'\n    ;;\nesac\n\nexec vllm serve $MTP_ARGS --kv-cache-dtype fp8 \\\n  zai-org/GLM-5.2-FP8 \\\n  --port 8000 \\\n  --trust-remote-code \\\n  --gpu-memory-utilization $GPU_MEM_UTIL \\\n  --max-model-len ${MAX_MODEL_LEN:-120000} \\\n  --disable-access-log-for-endpoints=/health,/metrics \\\n  --data-parallel-multi-port-external-lb \\\n  --data-parallel-supervisor-port=8208 \\\n  --enable-expert-parallel \\\n  --tensor-parallel-size $TP_SIZE \\\n  --data-parallel-size $((LWS_GROUP_SIZE * DP_SIZE_LOCAL)) \\\n  --data-parallel-size-local $DP_SIZE_LOCAL \\\n  --data-parallel-address ${LWS_LEADER_ADDRESS} \\\n  --data-parallel-rpc-port 5555 \\\n  --max-num-batched-tokens 2048 \\\n  --data-parallel-start-rank $START_RANK \\\n  --block-size 64 \\\n  $KV_EVENTS_ARGS \\\n  --kv_transfer_config \"$KV_TRANSFER_CONFIG\" \\\n  --moe-backend deep_gemm \\\n  --all2all-backend deepep_high_throughput"
