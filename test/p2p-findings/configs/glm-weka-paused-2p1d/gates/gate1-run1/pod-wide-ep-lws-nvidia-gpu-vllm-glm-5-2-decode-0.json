                "args": [
                    "find /dev/shm -type f -delete\n\n# Scale MAX_TOKENS with number of decode pods\nexport MAX_TOKENS=$(( ${MAX_TOKENS_PER_NODE:-128} * LWS_GROUP_SIZE ))\n\n# Wide-EP (multi-node): reserve VRAM for NVSHMEM symmetric heap\nGPU_MEM_UTIL=${DECODE_GPU_MEM_UTIL:-0.95}\n\n# DeepEP low-latency requires: qp_depth \u003e= (max_dispatch_tokens + 1) * 2\nexport NVSHMEM_QP_DEPTH=$(( (MAX_TOKENS + 1) * 2 ))\n\nMTP_ARGS=\"\"\nif [ \"${ENABLE_MTP:-1}\" = \"1\" ]; then\n  MTP_ARGS=\"--speculative-config {\\\"method\\\":\\\"mtp\\\",\\\"num_speculative_tokens\\\":${MTP_NUM_TOKENS:-3}}\"\nfi\n\nSTART_RANK=$(( ${LWS_WORKER_INDEX:-0} * DP_SIZE_LOCAL ))\nKV_EVENTS_BASE=$((5557 - START_RANK))\nKV_EVENTS_ARGS=\"--kv-events-config {\\\"enable_kv_cache_events\\\":true,\\\"publisher\\\":\\\"zmq\\\",\\\"endpoint\\\":\\\"tcp://*:${KV_EVENTS_BASE}\\\",\\\"topic\\\":\\\"kv@${POD_IP}:8000@zai-org/GLM-5.2-FP8\\\"}\"\n\ncase \"${OFFLOADING_MODE:-off}\" in\n  p2p-tiered)\n    P2P_BASE=$((7777 - START_RANK))\n    KV_TRANSFER_CONFIG='{\"kv_connector\":\"MultiConnector\",\n                          \"kv_role\":\"kv_both\",\n                          \"kv_load_failure_policy\":\"fail\",\n                          \"kv_connector_extra_config\":{\n                            \"connectors\":[\n                              {\"kv_connector\":\"NixlConnector\",\"kv_role\":\"kv_both\"},\n                              {\"kv_connector\":\"OffloadingConnector\",\"kv_role\":\"kv_both\",\n                               \"kv_connector_extra_config\":{\n                                 \"spec_name\":\"TieringOffloadingSpec\",\n                                 \"cpu_bytes_to_use\":'\"${KV_OFFLOAD_CPU_BYTES:-107374182400}\"',\n                                 \"eviction_policy\":\"lru\",\n                                 \"offload_prompt_only\":false,\n                                 \"secondary_tiers\":[{\"type\":\"p2p\",\"host\":\"'\"${POD_IP}\"'\",\"port\":'\"${P2P_BASE}\"'}]\n                            }}]}}'\n    ;;\n  *)\n    KV_TRANSFER_CONFIG='{\"kv_connector\":\"NixlConnector\",\n                          \"kv_role\":\"kv_both\",\n                          \"kv_load_failure_policy\":\"fail\"}'\n    ;;\nesac\n\nPROFILER_ARGS=\"\"\nif [ \"${ENABLE_PROFILING:-0}\" = \"1\" ]; then\n  mkdir -p /var/cache/vllm/profile\n  PROFILER_ARGS=\"--profiler-config {\\\"profiler\\\":\\\"torch\\\",\\\"torch_profiler_dir\\\":\\\"/var/cache/vllm/profile\\\",\\\"torch_profiler_record_shapes\\\":true,\\\"torch_profiler_with_memory\\\":true,\\\"max_iterations\\\":3}\"\nfi\n\nexec vllm serve $PROFILER_ARGS $MTP_ARGS --kv-cache-dtype fp8 \\\n  zai-org/GLM-5.2-FP8 \\\n  --port 8200 \\\n  --trust-remote-code \\\n  --gpu-memory-utilization $GPU_MEM_UTIL \\\n  --max-model-len ${MAX_MODEL_LEN:-120000} \\\n  --disable-access-log-for-endpoints=/health,/metrics \\\n  --data-parallel-multi-port-external-lb \\\n  --data-parallel-supervisor-port=8208 \\\n  --enable-expert-parallel \\\n  --tensor-parallel-size $TP_SIZE \\\n  --max-num-batched-tokens ${MAX_TOKENS} \\\n  --max-num-seqs ${MAX_TOKENS} \\\n  --data-parallel-size $((LWS_GROUP_SIZE * DP_SIZE_LOCAL)) \\\n  --data-parallel-size-local $DP_SIZE_LOCAL \\\n  --data-parallel-address ${LWS_LEADER_ADDRESS} \\\n  --data-parallel-rpc-port 5555 \\\n  --data-parallel-start-rank $START_RANK \\\n  --block-size 64 \\\n  $KV_EVENTS_ARGS \\\n  --kv_transfer_config \"$KV_TRANSFER_CONFIG\" \\\n  --all2all-backend deepep_low_latency \\\n  --moe-backend deep_gemm \\\n  --reasoning-parser glm45 \\\n  --tool-call-parser glm47 \\\n  --enable-auto-tool-choice \\\n  ${KV_CACHE_MEMORY_BYTES:+--kv-cache-memory-bytes=$KV_CACHE_MEMORY_BYTES}"
